local moduleCache: { [string]: any } = {}
local function loadData(path: string): any
	local value = moduleCache[path]
	if value == nil then
		local loader = MODULES[path]
		assert(loader, "Daten fehlen: " .. path)
		value = loader()
		moduleCache[path] = value
	end
	return value
end

local function hasData(path: string): boolean
	return MODULES[path] ~= nil
end

local function listData(path: string): { string }
	local names = {}
	for name in MODULES do
		if string.sub(name, 1, #path + 1) == path .. "/" then
			table.insert(names, name)
		end
	end
	table.sort(names)
	return names
end
